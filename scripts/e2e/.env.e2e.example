# Copy this file to `.env.e2e` (same folder) and fill in real values.
# `.env.e2e` is gitignored and loaded automatically by scripts/e2e/config.py.

# --- Target infrastructure -----------------------------------------------
# Switch these to point at a different shared/local deployment.
SWITCHER_API_URL=http://localhost:3000
SWITCHER_MANAGEMENT_URL=http://localhost:3001

# --- Existing account/domain/flag to validate against --------------------
# This flow assumes the account, domain, and feature flag already exist.
# It never signs up an account or creates any data.
E2E_ACCOUNT_EMAIL=you@example.com
E2E_ACCOUNT_PASSWORD=change-me
E2E_DOMAIN_NAME=My Domain
E2E_SWITCHER_KEY=MY_FEATURE_FLAG

# Optional: only needed if your flag has environment-specific overrides.
# E2E_ENVIRONMENT=default

# Optional: override where the isolated OAuth credentials cache is written.
# Defaults to scripts/e2e/.cache/<account-hash>-credentials.json so it never
# touches your real ~/.switcher-mcp/credentials.json.
# SWITCHER_MCP_CREDENTIALS_PATH=/absolute/path/to/credentials.json
